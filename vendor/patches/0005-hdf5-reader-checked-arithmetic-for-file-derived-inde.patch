+    fn num_pages(&self) -> usize {
+        self.entries_per_page
+            .map_or(0, |per_page| self.num_entries.div_ceil(per_page))
+    }
+
+    fn bitmap_bytes(&self) -> usize {
+        self.num_pages().div_ceil(8)

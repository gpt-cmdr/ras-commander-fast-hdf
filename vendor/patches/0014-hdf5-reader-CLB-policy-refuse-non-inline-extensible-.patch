From ff46b4cae06668d1585ca5d8199159afff0456f2 Mon Sep 17 00:00:00 2001
From: "William Mark Katzenmeyer, P.E., C.F.M." <heccommander@gmail.com>
Date: Sat, 24 Oct 2026 06:18:28 -0400
Subject: [PATCH 14/14] hdf5-reader (CLB policy): refuse non-inline
 extensible-array chunk indexes

[L07] Status vs upstream v0.9.3: NOT UPSTREAM; CLB policy (upstream mapping bug: file an issue).
Kind: policy. Proposed upstream grouping: not for upstream; report the EA mapping bug instead.
Applies on roteiro-gis/netcdf-rust v0.9.3 (3d708fd) after the earlier patches of this series.

The extensible-array mapping beyond the index block silently omits
allocated chunks: for a 50-chunk dataset written by h5py with
libver='latest' (tests/fixtures/perf2/ea_latest.h5), chunks 36-49 are
returned as fill values. Until the mapping is fixed, refuse extensible-array
indexes with more elements than the index block holds (full and bounded
reads) with Error::UnsupportedEncoding instead of returning wrong data.

This is a fail-closed qualification policy: it also refuses valid files
that the current mapping reads correctly (the extensible_array_chunked and
filtered_chunk_size_widths integration cases are adjusted accordingly).
The upstream fix is to correct the data/super block mapping.
---
 hdf5-reader/src/extensible_array.rs           |  99 ++++++++++--------
 hdf5-reader/tests/fixtures/perf2/ea_latest.h5 | Bin 0 -> 22248 bytes
 hdf5-reader/tests/integration.rs              |  26 ++---
 3 files changed, 63 insertions(+), 62 deletions(-)
 create mode 100644 hdf5-reader/tests/fixtures/perf2/ea_latest.h5

diff --git a/hdf5-reader/src/extensible_array.rs b/hdf5-reader/src/extensible_array.rs
index 26a5e67..752b567 100644
--- a/hdf5-reader/src/extensible_array.rs
+++ b/hdf5-reader/src/extensible_array.rs
@@ -1198,6 +1198,15 @@ pub fn collect_extensible_array_chunk_entries(
 ) -> Result<Vec<ChunkEntry>> {
     let header = parse_header(data, header_address, offset_size, length_size)?;
 
+    // Non-inline EA block geometry is not qualified: the old mapping silently
+    // omitted allocated chunks (including default indices 36+). Refuse both
+    // full and bounded reads rather than interpreting missing entries as fill.
+    if header._nelmts > u64::from(header.idx_blk_elmts) {
+        return Err(Error::UnsupportedEncoding(
+            "non-inline extensible-array chunk index (unqualified block mapping)".into(),
+        ));
+    }
+
     if Cursor::is_undefined_offset(header.index_block_address, offset_size) {
         return Ok(Vec::new());
     }
@@ -1436,6 +1445,15 @@ pub fn collect_extensible_array_chunk_entries_storage(
 ) -> Result<Vec<ChunkEntry>> {
     let header = parse_header_storage(storage, header_address, offset_size, length_size)?;
 
+    // Non-inline EA block geometry is not qualified: the old mapping silently
+    // omitted allocated chunks (including default indices 36+). Refuse both
+    // full and bounded reads rather than interpreting missing entries as fill.
+    if header._nelmts > u64::from(header.idx_blk_elmts) {
+        return Err(Error::UnsupportedEncoding(
+            "non-inline extensible-array chunk index (unqualified block mapping)".into(),
+        ));
+    }
+
     if Cursor::is_undefined_offset(header.index_block_address, offset_size) {
         return Ok(Vec::new());
     }
@@ -1798,6 +1816,24 @@ pub fn collect_extensible_array_chunk_entries_storage(
 
 #[cfg(test)]
 mod tests {
+    #[test]
+    fn perf2_ea_non_inline_refuses_full_slab_and_gather() {
+        let file =
+            crate::Hdf5File::from_bytes(include_bytes!("../tests/fixtures/perf2/ea_latest.h5"))
+                .unwrap();
+        let d = file.dataset("data").unwrap();
+        for error in [
+            d.read_array::<f32>().unwrap_err(),
+            d.read_rows_columns_chunked::<f32>((35, 50, 1), &[0, 100])
+                .unwrap_err(),
+            d.read_array_uncached::<f32>().unwrap_err(),
+        ] {
+            assert!(error
+                .to_string()
+                .contains("unsupported non-inline extensible-array"));
+        }
+    }
+
     use super::*;
     use crate::storage::{Storage, StorageBuffer};
     use std::sync::Mutex;
@@ -1969,51 +2005,24 @@ mod tests {
     }
 
     #[test]
-    fn storage_full_scan_reads_exact_secondary_and_data_block_lengths() {
-        let storage = storage_fixture();
-
-        let entries = collect_extensible_array_chunk_entries_storage(
-            &storage,
-            TEST_HEADER_ADDR,
-            TEST_OFFSET_SIZE,
-            TEST_LENGTH_SIZE,
-            &[7],
-            &[1],
-            None,
-        )
-        .unwrap();
-
-        assert!(!entries.is_empty());
-        let ranges = storage.ranges();
-        assert!(ranges.contains(&(TEST_HEADER_ADDR, 72)));
-        assert!(ranges.contains(&(TEST_INDEX_ADDR, 42)));
-        assert!(ranges.contains(&(TEST_SECONDARY_ADDR, 35)));
-        assert!(ranges.contains(&(TEST_DATA_BLOCK_ADDR, 35)));
-        assert!(ranges.iter().all(|(_, len)| *len <= 72), "{ranges:?}");
-    }
-
-    #[test]
-    fn storage_bounded_scan_reads_exact_index_block_length() {
+    fn non_inline_storage_scans_refuse_before_reading_index_blocks() {
         let storage = storage_fixture();
-        storage.clear_ranges();
-
-        let entries = collect_extensible_array_chunk_entries_storage(
-            &storage,
-            TEST_HEADER_ADDR,
-            TEST_OFFSET_SIZE,
-            TEST_LENGTH_SIZE,
-            &[7],
-            &[1],
-            Some((&[3], &[3])),
-        )
-        .unwrap();
-
-        assert_eq!(entries.len(), 1);
-        assert_eq!(entries[0].address, 0x2000);
-        let ranges = storage.ranges();
-        assert!(ranges.contains(&(TEST_HEADER_ADDR, 72)));
-        assert!(ranges.contains(&(TEST_INDEX_ADDR, 42)));
-        assert!(ranges.contains(&(TEST_SECONDARY_ADDR, 35)));
-        assert!(ranges.iter().all(|(_, len)| *len <= 72), "{ranges:?}");
+        for bounds in [None, Some((&[3u64][..], &[3u64][..]))] {
+            storage.clear_ranges();
+            let error = collect_extensible_array_chunk_entries_storage(
+                &storage,
+                TEST_HEADER_ADDR,
+                TEST_OFFSET_SIZE,
+                TEST_LENGTH_SIZE,
+                &[7],
+                &[1],
+                bounds,
+            )
+            .unwrap_err();
+            assert!(error
+                .to_string()
+                .contains("unsupported non-inline extensible-array"));
+            assert_eq!(storage.ranges(), vec![(TEST_HEADER_ADDR, 72)]);
+        }
     }
 }

+                        self.name
+                    )));
+                }
+                // Elements past the payload are not read, so never reserve them.
+                let mut result =
+                    Vec::with_capacity(n.min(self.raw_data.len().div_ceil(len.max(1))));
                 for i in 0..n {
                     let start = i * len;

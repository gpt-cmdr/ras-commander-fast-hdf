+    #[test]
+    fn old_group_cache_names_and_context_lifetime() {
+        // The fixture is an external old-format HEC-RAS file; skip without it so the
+        // crate's suite runs in CI and when vendored on its own.
+        let Ok(path) = std::env::var("HDF5_READER_CACHE_FIXTURE") else {
+            eprintln!("skipping: HDF5_READER_CACHE_FIXTURE is not set");
+            return;
+        };
+        let file = Hdf5File::open(path).unwrap();
+        let weak = Arc::downgrade(&file.context);
+        let g = file.root_group().unwrap();
+        let names = g.member_names().unwrap();
+        let objects = g.members().unwrap();
+        assert_eq!(
+            names.0,
+            objects
+                .0
+                .iter()
+                .map(|g| g.name().to_string())
+                .collect::<Vec<_>>()
+        );
+        assert_eq!(
+            names.1,
+            objects
+                .1
+                .iter()
+                .map(|d| d.name().to_string())
+                .collect::<Vec<_>>()
+        );
+        assert!(!file.context.old_groups.lock().is_empty());
+        let count = file.context.old_groups.lock().len();
+        assert_eq!(g.member_names().unwrap(), names);
+        assert_eq!(file.context.old_groups.lock().len(), count);
+        drop(objects);
+        drop(g);
+        drop(file);
+        assert!(
+            weak.upgrade().is_none(),
+            "group cache must not retain file context"
+        );
+    }

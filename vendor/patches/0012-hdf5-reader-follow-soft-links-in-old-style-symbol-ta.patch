From be8627772e32de599a3f53020473ae3603656fd0 Mon Sep 17 00:00:00 2001
From: "William Mark Katzenmeyer, P.E., C.F.M." <heccommander@gmail.com>
Date: Sat, 24 Oct 2026 06:16:21 -0400
Subject: [PATCH 12/14] hdf5-reader: follow soft links in old-style
 (symbol-table) groups

[L10] Status vs upstream v0.9.3: NOT UPSTREAM.
Kind: bug fix. Proposed upstream grouping: PR-A spec conformance (rebase onto upstream group.rs without L05 if sent first).
Applies on roteiro-gis/netcdf-rust v0.9.3 (3d708fd) after the earlier patches of this series.

Symbol-table entries with cache type 2 are soft links: the object header
address is undefined and the scratch pad holds the local-heap offset of
the link value. They were treated as hard links to an undefined address,
so a valid soft-linked dataset in an old-format file was reported
corrupt. Resolve them lazily through the shared link walk, omitting
unresolvable links like soft links in link messages.
---
 hdf5-reader/src/group.rs | 78 ++++++++++++++++++++++++++++++----------
 1 file changed, 59 insertions(+), 19 deletions(-)

diff --git a/hdf5-reader/src/group.rs b/hdf5-reader/src/group.rs
index 827ea8a..3e4e472 100644
--- a/hdf5-reader/src/group.rs
+++ b/hdf5-reader/src/group.rs
@@ -31,11 +31,17 @@ pub struct Group {
     pub(crate) root_address: u64,
 }
 
-/// Names and object-header addresses of an old-style (symbol-table) group, cached per
-/// group address so repeated lookups do not re-read the B-tree and local heap.
 pub(crate) struct OldGroupEntries {
-    entries: Vec<(String, u64)>,
-    names: std::collections::HashMap<String, u64>,
+    entries: Vec<(String, OldTarget)>,
+    names: std::collections::HashMap<String, OldTarget>,
+}
+/// A symbol-table (old-style group) entry target. Cache type 2 entries are soft links whose
+/// object-header address is undefined; their path is stored in the group's local heap and is
+/// resolved lazily (outside the `old_groups` lock), like soft links in link messages.
+#[derive(Clone)]
+enum OldTarget {
+    Hard(u64),
+    Soft(String),
 }
 #[derive(Clone)]
 struct ChildEntry {
@@ -376,12 +382,14 @@ impl Group {
         for msg in &header.messages {
             match msg {
                 HdfMessage::SymbolTable(st) => {
-                    let address = self.old_group_entries(st)?.names.get(name).copied();
-                    return Ok(address.map(|address| ChildEntry {
-                        name: name.into(),
-                        location: self.local_location(address),
-                        creation_order: None,
-                    }));
+                    let target = self.old_group_entries(st)?.names.get(name).cloned();
+                    return Ok(target.and_then(|t| self.old_target_location(&t, walk)).map(
+                        |location| ChildEntry {
+                            name: name.into(),
+                            location,
+                            creation_order: None,
+                        },
+                    ));
                 }
                 HdfMessage::Link(link) if link.name == name => {
                     matching_compact_link = Some(link.clone());
@@ -424,7 +432,7 @@ impl Group {
             match msg {
                 HdfMessage::SymbolTable(st) => {
                     found_symbol_table = true;
-                    children = self.resolve_old_style_group_storage(st)?;
+                    children = self.resolve_old_style_group_storage(st, walk)?;
                 }
                 HdfMessage::Link(link) => {
                     links.push(link.clone());
@@ -524,25 +532,42 @@ impl Group {
         let entries = self.read_old_style_group_storage(st)?;
         let mut names = std::collections::HashMap::new();
         for (n, a) in &entries {
-            names.entry(n.clone()).or_insert(*a);
+            names.entry(n.clone()).or_insert_with(|| a.clone());
         }
         let value = Arc::new(OldGroupEntries { entries, names });
         cache.insert(self.address, value.clone());
         Ok(value)
     }
-    fn resolve_old_style_group_storage(&self, st: &SymbolTableMessage) -> Result<Vec<ChildEntry>> {
+    /// Unresolvable soft links are omitted, matching soft links in link messages.
+    fn old_target_location(&self, target: &OldTarget, walk: &LinkWalk) -> Option<ObjectLocation> {
+        match target {
+            OldTarget::Hard(address) => Some(self.local_location(*address)),
+            OldTarget::Soft(path) => self.resolve_soft_link(path, walk).ok(),
+        }
+    }
+    fn resolve_old_style_group_storage(
+        &self,
+        st: &SymbolTableMessage,
+        walk: &LinkWalk,
+    ) -> Result<Vec<ChildEntry>> {
         let entries = self.old_group_entries(st)?;
         Ok(entries
             .entries
             .iter()
-            .map(|(n, address)| ChildEntry {
-                name: n.clone(),
-                location: self.local_location(*address),
-                creation_order: None,
+            .filter_map(|(n, t)| {
+                self.old_target_location(t, walk)
+                    .map(|location| ChildEntry {
+                        name: n.clone(),
+                        location,
+                        creation_order: None,
+                    })
             })
             .collect())
     }
-    fn read_old_style_group_storage(&self, st: &SymbolTableMessage) -> Result<Vec<(String, u64)>> {
+    fn read_old_style_group_storage(
+        &self,
+        st: &SymbolTableMessage,
+    ) -> Result<Vec<(String, OldTarget)>> {
         let heap = LocalHeap::parse_at_storage(
             self.context.storage.as_ref(),
             st.heap_address,
@@ -602,7 +627,22 @@ impl Group {
                     entry.link_name_offset,
                     heap_bytes.as_ref().expect("loaded for first name").as_ref(),
                 )?;
-                children.push((name, entry.object_header_address));
+                let target = if entry.cache_type == 2 {
+                    // Scratch pad holds the 4-byte local-heap offset of the soft link value.
+                    let offset = u32::from_le_bytes([
+                        entry.scratch[0],
+                        entry.scratch[1],
+                        entry.scratch[2],
+                        entry.scratch[3],
+                    ]);
+                    OldTarget::Soft(heap.get_string_segment(
+                        u64::from(offset),
+                        heap_bytes.as_ref().expect("loaded for first name").as_ref(),
+                    )?)
+                } else {
+                    OldTarget::Hard(entry.object_header_address)
+                };
+                children.push((name, target));
             }
         }
 

         entry: &chunk_index::ChunkEntry,
@@ -4166,6 +4414,64 @@ fn slice_array<T: H5Type + Clone>(
 
 #[cfg(test)]
 mod tests {
+    #[test]
+    fn perf2_gather_and_uncached_reads() {
+        let file = crate::Hdf5File::from_bytes(include_bytes!("../tests/fixtures/perf2/gather.h5"))
+            .unwrap();
+        macro_rules! check {
+            ($ty:ty,$name:expr) => {{
+                let d = file.dataset($name).unwrap();
+                let full = d.read_array::<$ty>().unwrap();
+                let cols = [18, 0, 7, 7, 13];
+                let got = d
+                    .read_rows_columns_chunked::<$ty>((2, 17, 3), &cols)
+                    .unwrap()
+                    .unwrap();
+                for (out, row) in (2..17).step_by(3).enumerate() {
+                    for (col, &id) in cols.iter().enumerate() {
+                        assert_eq!(got[[out, col]], full[[row, id as usize]]);
+                    }
+                }
+                #[cfg(feature = "rayon")]
+                {
+                    let pool = rayon::ThreadPoolBuilder::new()
+                        .num_threads(4)
+                        .build()
+                        .unwrap();
+                    let cold = crate::Hdf5File::from_bytes(include_bytes!(
+                        "../tests/fixtures/perf2/gather.h5"
+                    ))
+                    .unwrap()
+                    .dataset($name)
+                    .unwrap();
+                    let parallel = pool
+                        .install(|| {
+                            cold.read_rows_columns_chunked_parallel::<$ty>((2, 17, 3), &cols)
+                        })
+                        .unwrap()
+                        .unwrap();
+                    assert_eq!(parallel, got);
+                }
+                assert_eq!(d.read_array_uncached::<$ty>().unwrap(), full);
+                #[cfg(feature = "rayon")]
+                assert_eq!(d.read_array_uncached_parallel::<$ty>().unwrap(), full);
+                assert!(d
+                    .read_rows_columns_chunked::<$ty>((0, 18, 1), &cols)
+                    .is_err());
+                assert!(d
+                    .read_rows_columns_chunked::<$ty>((0, 17, 1), &[])
+                    .unwrap()
+                    .unwrap()
+                    .is_empty());
+            }};
+        }
+        for suffix in ["plain", "filtered"] {
+            check!(f32, &format!("lef4{suffix}"));
+            check!(i32, &format!("bei4{suffix}"));
+            check!(f64, &format!("lef8{suffix}"));
+        }
+        check!(i32, "fill");
+    }
     use super::*;
     use crate::storage::BytesStorage;
 

From 933149635d3f549d3c963223a09083e8e3535ebf Mon Sep 17 00:00:00 2001
From: "William Mark Katzenmeyer, P.E., C.F.M." <heccommander@gmail.com>
Date: Sat, 24 Oct 2026 06:11:48 -0400
Subject: [PATCH 04/14] hdf5-reader: release in-flight chunk loads when the
 loader panics

[L14] Status vs upstream v0.9.3: NOT UPSTREAM.
Kind: safety fix. Proposed upstream grouping: PR-B hardening.
Applies on roteiro-gis/netcdf-rust v0.9.3 (3d708fd) after the earlier patches of this series.

ChunkCache::get_or_insert_with now clears the in-flight entry and wakes
waiters from a drop guard, so a panicking decoder no longer leaves the key
registered and every later load of that chunk blocked forever.
---
 hdf5-reader/src/cache.rs | 100 ++++++++++++++++++++++++++++++++++++---
 1 file changed, 94 insertions(+), 6 deletions(-)

diff --git a/hdf5-reader/src/cache.rs b/hdf5-reader/src/cache.rs
index 22add51..f4ecb23 100644
--- a/hdf5-reader/src/cache.rs
+++ b/hdf5-reader/src/cache.rs
@@ -43,6 +43,26 @@ struct InFlightLoad {
     ready: Condvar,
 }
 
+/// Clears an in-flight load and wakes its waiters when dropped, including
+/// while unwinding from a panicking loader. Without it a decoder panic left
+/// the key registered forever and every later load of that chunk blocked.
+/// Waiters then find no cached value and retry the load themselves.
+struct InFlightGuard<'a> {
+    cache: &'a ChunkCache,
+    key: &'a ChunkKey,
+    load: &'a InFlightLoad,
+}
+
+impl Drop for InFlightGuard<'_> {
+    fn drop(&mut self) {
+        let mut state = self.cache.inner.lock();
+        state.in_flight.remove(self.key);
+        let mut completed = self.load.completed.lock();
+        *completed = true;
+        self.load.ready.notify_all();
+    }
+}
+
 /// Point-in-time statistics for a [`ChunkCache`].
 #[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
 pub struct ChunkCacheStats {
@@ -143,13 +163,13 @@ impl ChunkCache {
                     state.in_flight.insert(key.clone(), Arc::clone(&in_flight));
                     drop(state);
 
+                    let guard = InFlightGuard {
+                        cache: self,
+                        key: &key,
+                        load: &in_flight,
+                    };
                     let result = load().map(|data| self.insert(key.clone(), data));
-
-                    let mut state = self.inner.lock();
-                    state.in_flight.remove(&key);
-                    let mut completed = in_flight.completed.lock();
-                    *completed = true;
-                    in_flight.ready.notify_all();
+                    drop(guard);
 
                     return result;
                 }
@@ -189,6 +209,74 @@ impl Default for ChunkCache {
 mod tests {
     use super::*;
 
+    fn panic_key() -> ChunkKey {
+        ChunkKey {
+            dataset_addr: 42,
+            chunk_offsets: SmallVec::from_vec(vec![0]),
+        }
+    }
+
+    #[test]
+    fn panicking_loader_does_not_leak_its_in_flight_entry() {
+        let cache = Arc::new(ChunkCache::new(1 << 20, 16));
+        let panicked = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            let _ = cache.get_or_insert_with(panic_key(), || panic!("decoder panic"));
+        }));
+        assert!(panicked.is_err());
+        assert_eq!(cache.stats().in_flight, 0);
+
+        // A later load of the same chunk runs instead of waiting forever.
+        let (tx, rx) = std::sync::mpsc::channel();
+        let c2 = Arc::clone(&cache);
+        std::thread::spawn(move || {
+            let _ = tx.send(c2.get_or_insert_with(panic_key(), || Ok(vec![1, 2, 3])));
+        });
+        let loaded = rx
+            .recv_timeout(std::time::Duration::from_secs(30))
+            .expect("second load must not block on the leaked entry")
+            .unwrap();
+        assert_eq!(*loaded, vec![1, 2, 3]);
+    }
+
+    #[test]
+    fn waiter_on_a_panicking_load_retries_it() {
+        let cache = Arc::new(ChunkCache::new(1 << 20, 16));
+        let (started_tx, started_rx) = std::sync::mpsc::channel();
+        let (go_tx, go_rx) = std::sync::mpsc::channel::<()>();
+        let loader = {
+            let cache = Arc::clone(&cache);
+            std::thread::spawn(move || {
+                std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                    let _ = cache.get_or_insert_with(panic_key(), || {
+                        started_tx.send(()).unwrap();
+                        go_rx.recv().unwrap();
+                        panic!("decoder panic")
+                    });
+                }))
+                .is_err()
+            })
+        };
+        started_rx.recv().unwrap();
+        let (tx, rx) = std::sync::mpsc::channel();
+        let waiter = {
+            let cache = Arc::clone(&cache);
+            std::thread::spawn(move || {
+                let _ = tx.send(cache.get_or_insert_with(panic_key(), || Ok(vec![7])));
+            })
+        };
+        // Let the waiter block on the in-flight entry, then fail the load.
+        std::thread::sleep(std::time::Duration::from_millis(50));
+        go_tx.send(()).unwrap();
+        assert!(loader.join().unwrap());
+        let loaded = rx
+            .recv_timeout(std::time::Duration::from_secs(30))
+            .expect("waiter must be released when the loader panics")
+            .unwrap();
+        assert_eq!(*loaded, vec![7]);
+        waiter.join().unwrap();
+        assert_eq!(cache.stats().in_flight, 0);
+    }
+
     #[test]
     fn cache_insert_and_get() {
         let cache = ChunkCache::new(1024, 10);

+    /// Exact datatype envelope retained before semantic parser normalization.
+    pub fn raw_datatype(&self) -> Result<Vec<u8>> {
+        let header = self.context.get_or_parse_header(self.data_address)?;
+        let mut messages = header.messages.iter().filter_map(|m| match m {
+            HdfMessage::Datatype(dt) => Some(&dt.raw_encoding),
+            _ => None,
+        });
+        let raw = messages
+            .next()
+            .ok_or_else(|| Error::InvalidData("missing datatype".into()))?;
+        if messages.next().is_some() {
+            return Err(Error::InvalidData("duplicate datatype".into()));
+        }
+        Ok(raw.clone())
+    }

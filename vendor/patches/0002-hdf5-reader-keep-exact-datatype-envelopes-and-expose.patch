+
+#[cfg(test)]
+mod encoding_envelope_tests {
+    use super::*;
+    #[test]
+    fn raw_integer_encoding_survives_normalization() {
+        let raw = [0x10, 0x09, 0, 0, 8, 0, 0, 0, 1, 0, 63, 0];
+        let mut c = Cursor::new(&raw);
+        let dt = parse(&mut c, raw.len()).unwrap();
+        assert_eq!(dt.raw_encoding, raw);
+        assert!(matches!(
+            dt.datatype,
+            Datatype::FixedPoint {
+                size: 8,
+                signed: true,
+                ..
+            }
+        ));
+        assert!(parse(&mut Cursor::new(&raw), 8).is_err());
+    }
+    #[test]
+    fn reserved_string_flags_survive_normalization() {
+        for flags in [3, 32, 255] {
+            let raw = [0x13, flags, 0, 0, 4, 0, 0, 0];
+            let dt = parse(&mut Cursor::new(&raw), raw.len()).unwrap();
+            assert_eq!(dt.raw_encoding, raw);
+        }
+    }
+}

From e34921ca66c3aac4b50a5562e6b172896f97edc9 Mon Sep 17 00:00:00 2001
From: "William Mark Katzenmeyer, P.E., C.F.M." <heccommander@gmail.com>
Date: Sat, 24 Oct 2026 06:14:24 -0400
Subject: [PATCH 08/14] hdf5-reader (CLB policy): refuse unbounded filters in
 bounded reads

[L08b] Status vs upstream v0.9.3: NOT UPSTREAM; CLB policy.
Kind: policy. Proposed upstream grouping: not for upstream.
Applies on roteiro-gis/netcdf-rust v0.9.3 (3d708fd) after the earlier patches of this series.

When a decoded-size limit is in force (every chunked dataset read), refuse
custom/registered filters and earlier pipeline stages without a qualified
encoded-size bound (unknown ids, LZ4, overridden built-ins) with
UnsupportedFilter instead of running them unbounded.

This is a fail-closed qualification policy of the ras-commander engine; it
disables registered custom filters for dataset reads and is not intended
for upstream as is.
---
 hdf5-reader/src/filters/mod.rs | 114 +++++++++++++++++++++++++--------
 1 file changed, 86 insertions(+), 28 deletions(-)

diff --git a/hdf5-reader/src/filters/mod.rs b/hdf5-reader/src/filters/mod.rs
index fda4c95..63bec43 100644
--- a/hdf5-reader/src/filters/mod.rs
+++ b/hdf5-reader/src/filters/mod.rs
@@ -90,6 +90,12 @@ impl FilterRegistry {
             Some(FilterImplementation::Builtin) => {
                 apply_builtin_filter_with_limit(filter, data, element_size, max_output_len)
             }
+            Some(FilterImplementation::Custom(_)) if max_output_len.is_some() => {
+                Err(Error::UnsupportedFilter(format!(
+                    "custom filter {} has no qualified decoded-size bound",
+                    filter.id
+                )))
+            }
             Some(FilterImplementation::Custom(f)) => f(filter, data, element_size),
             None => Err(Error::UnsupportedFilter(format!("filter id {}", filter.id))),
         }
@@ -179,27 +185,29 @@ pub fn apply_pipeline_with_limit(
         // A decoded intermediate may still be compressed by an earlier filter.
         // Its bound is the forward encoded-size bound of that prefix, not the
         // final chunk size (e.g. two DEFLATE filters on an eight-byte chunk).
-        // A prefix with no known bound leaves the stage to the per-filter
-        // ceiling; the final output is still checked against the limit.
-        let stage_limit = max_output_len.and_then(|n| {
-            filters[..i]
-                .iter()
-                .enumerate()
-                .filter(|(j, _)| filter_mask & (1 << j) == 0)
-                .try_fold(n, |n, (_, earlier)| {
-                    let custom = registry.is_some_and(|reg| {
+        let stage_limit = match max_output_len {
+            Some(mut n) => {
+                for (j, earlier) in filters[..i].iter().enumerate() {
+                    if filter_mask & (1 << j) != 0 {
+                        continue;
+                    }
+                    if registry.is_some_and(|reg| {
                         matches!(
                             reg.filters.get(&earlier.id),
                             Some(FilterImplementation::Custom(_))
                         )
-                    });
-                    if custom {
-                        None
-                    } else {
-                        encoded_size_bound(earlier.id, n)
+                    }) {
+                        return Err(Error::UnsupportedFilter(format!(
+                            "custom filter {} has no qualified encoded-size bound",
+                            earlier.id
+                        )));
                     }
-                })
-        });
+                    n = encoded_size_bound(earlier.id, n)?;
+                }
+                Some(n)
+            }
+            None => None,
+        };
         owned = Some(if let Some(reg) = registry {
             reg.apply_with_limit(filter, input, element_size, stage_limit)?
         } else {
@@ -212,11 +220,10 @@ pub fn apply_pipeline_with_limit(
     Ok(output)
 }
 
-/// Forward encoded-size bound of a built-in filter applied to `n` bytes, or
-/// `None` when the codec has no bound qualified here (unknown filters, LZ4
-/// framing).
-fn encoded_size_bound(id: u16, n: usize) -> Option<usize> {
-    Some(match id {
+/// Forward bounds for active built-in prefixes. Unknown/custom codecs and LZ4 framing
+/// are deliberately unqualified here; single LZ4 decode still enforces its declared size.
+fn encoded_size_bound(id: u16, n: usize) -> Result<usize> {
+    Ok(match id {
         FILTER_DEFLATE => n
             .saturating_add(n >> 12)
             .saturating_add(n >> 14)
@@ -226,7 +233,11 @@ fn encoded_size_bound(id: u16, n: usize) -> Option<usize> {
         // HDF5 scale-offset header plus at most one padding byte.
         FILTER_SCALEOFFSET => n.saturating_add(22),
         FILTER_SHUFFLE | FILTER_NBIT => n,
-        _ => return None,
+        _ => {
+            return Err(Error::UnsupportedFilter(format!(
+                "filter {id} has no qualified encoded-size bound in a bounded pipeline"
+            )))
+        }
     })
 }
 
@@ -319,13 +330,61 @@ mod tests {
         }
     }
     #[test]
-    fn expanding_prefix_bounds() {
-        assert_eq!(encoded_size_bound(FILTER_SCALEOFFSET, 256), Some(278));
+    fn expanding_prefix_bounds_and_explicit_refusals() {
+        assert_eq!(encoded_size_bound(FILTER_SCALEOFFSET, 256).unwrap(), 278);
         assert_eq!(
-            encoded_size_bound(FILTER_SCALEOFFSET, usize::MAX),
-            Some(usize::MAX)
+            encoded_size_bound(FILTER_SCALEOFFSET, usize::MAX).unwrap(),
+            usize::MAX
+        );
+        let filter = |id| FilterDescription {
+            id,
+            name: None,
+            client_data: vec![],
+        };
+        let mut registry = FilterRegistry::new();
+        registry.register(
+            50000,
+            Box::new(|_, _, _| panic!("unbounded custom filter must not run")),
+        );
+        for filters in [
+            vec![filter(50000)],
+            vec![filter(50000), filter(FILTER_DEFLATE)],
+            vec![filter(FILTER_LZ4), filter(FILTER_DEFLATE)],
+        ] {
+            assert!(matches!(
+                apply_pipeline_with_limit(&[], &filters, 0, 4, Some(&registry), Some(256)),
+                Err(Error::UnsupportedFilter(_))
+            ));
+        }
+        // Even an override of a known builtin has no declared expansion bound.
+        registry.register(
+            FILTER_SHUFFLE,
+            Box::new(|_, _, _| panic!("override must not run")),
+        );
+        assert!(matches!(
+            apply_pipeline_with_limit(
+                &[],
+                &[filter(FILTER_SHUFFLE), filter(FILTER_DEFLATE)],
+                0,
+                4,
+                Some(&registry),
+                Some(256)
+            ),
+            Err(Error::UnsupportedFilter(_))
+        ));
+        // A masked unknown prefix imposes no bound and is never called.
+        assert_eq!(
+            apply_pipeline_with_limit(
+                &[],
+                &[filter(50000), filter(FILTER_SHUFFLE)],
+                1,
+                4,
+                None,
+                Some(0)
+            )
+            .unwrap(),
+            Vec::<u8>::new()
         );
-        assert_eq!(encoded_size_bound(50000, 256), None);
     }
     #[test]
     fn scaleoffset_then_deflate_matches_full_h5py_values() {
@@ -339,7 +398,6 @@ mod tests {
             .collect();
         assert_eq!(values.as_slice().unwrap(), expected);
     }

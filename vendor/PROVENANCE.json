            "pattern": "(\\n[ \\t]*)#\\[test\\](\\r?\\n[ \\t]*fn test_mlt_core_)",
            "replacement": "\\1#[cfg(any(/* upstream test needs the dev-dependency mlt-core, not vendored */))]\\1#[test]\\2"
          }
        ]
      }
    }
  },

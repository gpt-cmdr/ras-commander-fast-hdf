          {
            "pattern": "(?<![\\w$:])crate::",
            "replacement": "crate::freestiler_core::"
          },
          {
            "pattern": "feature = \"(duckdb|fastpfor|fsst|geoparquet)\"",
            "replacement": "any(/* upstream feature \"\\1\" is not vendored */)"
